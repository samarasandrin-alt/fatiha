
const perguntas = [
    {
        pergunta: "A inteligência artificial deveria substituir pessoas no trabalho?",
        alternativas: [
            "Sim, para aumentar a produtividade.",
            "Não, ela deve apenas ajudar as pessoas."
        ]
    },
    {
        pergunta: "A IA deveria poder tomar decisões importantes sozinha?",
        alternativas: [
            "Sim, ela pode ser mais rápida e eficiente.",
            "Não, os seres humanos devem supervisionar."
        ]
    },
    {
        pergunta: "Você usaria uma IA para ajudar nos estudos?",
        alternativas: [
            "Sim, ela pode facilitar o aprendizado.",
            "Não, prefiro aprender sem inteligência artificial."
        ]
    },
    {
        pergunta: "Como você imagina o futuro da inteligência artificial?",
        alternativas: [
            "Um futuro com muita tecnologia e inovação.",
            "Um futuro que precisa de mais limites e cuidados."
        ]
    }
];

let perguntaAtual = 0;
let respostas = [];

const inicio = document.getElementById("inicio");
const jogo = document.getElementById("jogo");
const caixaPerguntas = document.querySelector(".caixa-perguntas");
const caixaAlternativas = document.querySelector(".caixa-alternativas");
const caixaResultado = document.querySelector(".caixa-resultado");
const textoResultado = document.querySelector(".texto-resultado");
const numeroPergunta = document.getElementById("numero-pergunta");
const botaoReiniciar = document.getElementById("reiniciar");

function iniciarJogo() {
    inicio.style.display = "none";
    jogo.style.display = "block";

    perguntaAtual = 0;
    respostas = [];

    botaoReiniciar.style.display = "none";

    mostrarPergunta();
}

function mostrarPergunta() {
    caixaResultado.style.display = "none";
    caixaPerguntas.style.display = "block";
    caixaAlternativas.style.display = "flex";

    const pergunta = perguntas[perguntaAtual];

    numeroPergunta.textContent =
        `Pergunta ${perguntaAtual + 1} de ${perguntas.length}`;

    caixaPerguntas.textContent = pergunta.pergunta;
    caixaAlternativas.innerHTML = "";

    pergunta.alternativas.forEach((alternativa) => {
        const botao = document.createElement("button");

        botao.textContent = alternativa;

        botao.onclick = () => {
            respostas.push(alternativa);
            proximaPergunta();
        };

        caixaAlternativas.appendChild(botao);
    });
}

function proximaPergunta() {
    perguntaAtual++;

    if (perguntaAtual < perguntas.length) {
        mostrarPergunta();
    } else {
        mostrarResultado();
    }
}

function mostrarResultado() {
    caixaPerguntas.style.display = "none";
    caixaAlternativas.style.display = "none";

    numeroPergunta.textContent = "Fim das perguntas!";

    caixaResultado.style.display = "block";

    const positivas = [
        perguntas[0].alternativas[0],
        perguntas[1].alternativas[0],
        perguntas[2].alternativas[0],
        perguntas[3].alternativas[0]
    ];

    const totalPositivas = respostas.filter(resposta =>
        positivas.includes(resposta)
    ).length;

    if (totalPositivas >= 3) {

        textoResultado.textContent =
            "Você acredita no potencial da inteligência artificial! Suas escolhas mostram que você vê a tecnologia como uma grande oportunidade para transformar o futuro, facilitar tarefas e trazer inovação para a sociedade.";

    } else if (totalPositivas <= 1) {

        textoResultado.textContent =
            "Você tem uma visão cautelosa sobre a inteligência artificial! Suas escolhas mostram que você valoriza a participação humana e acredita que a tecnologia precisa de limites, cuidados e supervisão.";

    } else {

        textoResultado.textContent =
            "Você tem uma visão equilibrada sobre a inteligência artificial! Suas escolhas mostram que reconhece os benefícios da tecnologia, mas também entende a importância dos cuidados e da responsabilidade em seu uso.";
    }

    botaoReiniciar.style.display = "inline-block";
}

function reiniciarJogo() {
    iniciarJogo();
}
