@import url('https://fonts.googleapis.com/css2?family=Roboto&family=Roboto+Mono&display=swap');

:root {
    --branco: #FFEDED;
    --cor-de-fundo: #4D0001;
    --fundo-senha: #720002;
    --fundo-texto: #2D1010;
    --borda: #FF0004;
    --roboto: 'Roboto', sans-serif;
    --roboto-mono: 'Roboto Mono', monospace;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-weight: 400;
}

body {
    color: var(--branco);
    background-color: var(--cor-de-fundo);
    font-family: var(--roboto);
}

.conteudo {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px 40px;
}

.conteudo-titulo {
    text-align: center;
    margin-top: 60px;
}

.conteudo-titulo img {
    width: 48px;
    height: 48px;
    margin-bottom: 12px;
}

.titulo-principal {
    font-family: var(--roboto-mono);
    font-size: 32px;
}

.titulo-secundario {
    font-size: 20px;
    margin-top: 8px;
    opacity: 0.9;
}

.conteudo-senha {
    margin-top: 40px; 
    background: var(--fundo-senha);
    padding: 24px;
    border-bottom: 6px solid var(--borda);
    border-radius: 8px 8px 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.conteudo-senha label {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.8;
}

#campo-senha {
    background-color: transparent;
    border: none;
    color: var(--branco);
    font-family: var(--roboto-mono);
    font-size: 32px;
    width: 100%;
}

#campo-senha:focus {
    outline: none;
}

.parametro {
    background-color: var(--fundo-texto);
    border: 2px solid var(--borda);
    border-radius: 0 0 8px 8px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.parametro-titulo {
    font-family: var(--roboto-mono);
    font-size: 24px;
}

.parametro-coluna__senha {
    display: flex;
    flex-direction: column;
    gap: 32px;
}

.parametro-senha {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.parametro-senha__titulo {
    font-size: 20px;
}

.parametro-senha-checkbox {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 4px;
}

.parametro-senha-checkbox .checkbox {
    width: 20px;
    height: 20px;
    cursor: pointer;
    accent-color: var(--borda);
}

.parametro-senha-checkbox label {
    cursor: pointer;
    font-size: 16px;
}

.parametro-senha-botoes {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 8px;
}

.parametro-senha__botao {
    background-color: var(--fundo-senha);
    color: var(--branco);
    border: 1px solid var(--borda);
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 20px;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
}

.parametro-senha__botao:hover {
    background-color: var(--borda);
}

.parametro-senha__botao:active {
    transform: scale(0.95);
}

.parametro-senha__texto {
    font-family: var(--roboto-mono);
    font-size: 24px;
    font-weight: bold;
    min-width: 32px;
    text-align: center;
}

.barra {
    background-color: var(--fundo-senha);
    height: 20px;
    width: 100%;
    border: 1px solid var(--borda);
    border-radius: 10px;
    overflow: hidden;
    margin-top: 8px;
}

.forte {
    height: 100%;
    width: 0%;
    background-color: #ff3c00;
    border-radius: 8px;
    transition: width 0.3s ease, background-color 0.3s ease;
}

.parametro-senha-textos {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    margin-top: 4px;
    opacity: 0.8;
}

@media screen and (min-width: 768px) {
    .parametro-coluna__senha {
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-start;
    }

    .parametro-senha {
        width: 30%;
    }
}
